# Local editor/agent state (contains absolute paths and machine-specific ids)
.freebuff/

# Local test harness. Its strongest fixtures are rebuilt from a saved copy of a
# real gradebook page, so they hold a student id, a district portal domain, a
# teacher name and real assignment scores. Keep the suite on this machine.
mktest.js
make-real-fixture.js
make-classlist-fixture.js
make-ungraded-points-fixture.js
test-*.html

# Throwaway check helpers and their output (see .freebuff/run.md). Note this
# does NOT cover the `make-*` fixture generators above, which are keepers.
mk-*.js
test-all.html
wrap.html
frame-*.html
shot-*.png
check*.png

# Build intermediates. `node build.js` regenerates both from bookmarklet.js.
bookmarklet.min.js
bookmarklet.raw.txt

# Local design notes, kept on disk only
design-system/

# OS noise
Thumbs.db
desktop.ini
.DS_Store

# npm droppings. Node builtins are the only require() targets in this repo, so
# nothing here should ever exist; ignored so an accidental `npm install` can
# never get tracked.
node_modules/
package.json
package-lock.json
